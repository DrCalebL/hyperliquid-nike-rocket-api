{
  "contract": "rocket-close-v2",
  "spec": "massive-rocket-algos docs/superpowers/specs/2026-10-06-t1-live-design.md section 19.3",
  "note": "Byte-identical in massive-rocket-algos, hyperliquid-nike-rocket-api and kraken-nike-rocket-api (tests/fixtures/close_v2.json); every gate compares its newline-normalised sha256. Each case runs through close_guard.validate_close_payload(payload, known_symbols, now_ms): expect 200 -> None, expect 422 -> a reason that starts with field.",
  "endpoint": "POST /api/broadcast-close",
  "auth_header": "X-Master-Key",
  "now_ms": 1760000000000,
  "known_symbols": ["ADA/USDT"],
  "responses": {
    "first": {"accepted": true, "duplicate": false, "followers_matched": 3},
    "repeat": {"accepted": true, "duplicate": true, "followers_matched": 3}
  },
  "cases": [
    {"name": "valid_buy", "expect": 200, "field": null,
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "valid_sell", "expect": 200, "field": null,
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "fedcba9876543210fedcba9876543210", "symbol": "ADA/USDT", "side": "SELL", "reason": "time_exit", "master_closed_ms": 1759999000000}},
    {"name": "valid_oldest_edge_48h", "expect": 200, "field": null,
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1759827200000}},
    {"name": "valid_newest_edge_5m", "expect": 200, "field": null,
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000300000}},
    {"name": "valid_extra_field_ignored", "expect": 200, "field": null,
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000, "future_field": "x"}},
    {"name": "not_an_object", "expect": 422, "field": "payload",
     "payload": ["CLOSE"]},
    {"name": "protocol_missing", "expect": 422, "field": "protocol",
     "payload": {"action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "protocol_1", "expect": 422, "field": "protocol",
     "payload": {"protocol": 1, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "protocol_string", "expect": 422, "field": "protocol",
     "payload": {"protocol": "2", "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "protocol_float", "expect": 422, "field": "protocol",
     "payload": {"protocol": 2.0, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "action_lowercase", "expect": 422, "field": "action",
     "payload": {"protocol": 2, "action": "close", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "action_buy", "expect": 422, "field": "action",
     "payload": {"protocol": 2, "action": "BUY", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "id_missing", "expect": 422, "field": "master_trade_id",
     "payload": {"protocol": 2, "action": "CLOSE", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "id_uppercase", "expect": 422, "field": "master_trade_id",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789ABCDEF0123456789ABCDEF", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "id_31_chars", "expect": 422, "field": "master_trade_id",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcde", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "id_33_chars", "expect": 422, "field": "master_trade_id",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef0", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "id_trailing_newline", "expect": 422, "field": "master_trade_id",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef\n", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "id_uuid_dashes", "expect": 422, "field": "master_trade_id",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "01234567-89ab-cdef-0123-456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "id_not_string", "expect": 422, "field": "master_trade_id",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": 1234, "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "symbol_empty", "expect": 422, "field": "symbol",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "symbol_unknown", "expect": 422, "field": "symbol",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ZZZ/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "symbol_venue_format", "expect": 422, "field": "symbol",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "side_lowercase", "expect": 422, "field": "side",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "buy", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "side_long", "expect": 422, "field": "side",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "LONG", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "side_missing", "expect": 422, "field": "side",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "reason": "time_exit", "master_closed_ms": 1760000000000}},
    {"name": "reason_stop_loss", "expect": 422, "field": "reason",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "stop_loss", "master_closed_ms": 1760000000000}},
    {"name": "reason_missing", "expect": 422, "field": "reason",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "master_closed_ms": 1760000000000}},
    {"name": "closed_ms_too_old", "expect": 422, "field": "master_closed_ms",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1759827199999}},
    {"name": "closed_ms_too_new", "expect": 422, "field": "master_closed_ms",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000300001}},
    {"name": "closed_ms_seconds_not_ms", "expect": 422, "field": "master_closed_ms",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000}},
    {"name": "closed_ms_float", "expect": 422, "field": "master_closed_ms",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": 1760000000000.0}},
    {"name": "closed_ms_string", "expect": 422, "field": "master_closed_ms",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": "1760000000000"}},
    {"name": "closed_ms_bool", "expect": 422, "field": "master_closed_ms",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit", "master_closed_ms": true}},
    {"name": "closed_ms_missing", "expect": 422, "field": "master_closed_ms",
     "payload": {"protocol": 2, "action": "CLOSE", "master_trade_id": "0123456789abcdef0123456789abcdef", "symbol": "ADA/USDT", "side": "BUY", "reason": "time_exit"}}
  ]
}
